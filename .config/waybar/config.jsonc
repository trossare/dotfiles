{
  "layer": "top",
  "height": 20,
  "spacing": 5,
  "modules-left": [
    "custom/padding",
    "clock",
    // "pulseaudio",
    // "bluetooth",
    "cpu",
    "memory",
    "custom/backup",
    "custom/opencode",
    // "hyprland/workspaces",
    "tray",
    "hyprland/submap"
  ],
  "modules-center": [
    // "clock"
    "hyprland/workspaces"
  ],
  "modules-right": [
    "backlight",
    "idle_inhibitor",
    // "memory",
    // "cpu",
    "custom/spotifyd",
    "bluetooth",
    "pulseaudio",
    "custom/vpn",
    "network",
    "power-profiles-daemon",
    // "custom/battery",
    "battery",
    "custom/padding"
  ],
  "hyprland/submap": {
    "format": "  {}",
    "max-length": 8,
    "tooltip": false
  },
  "tray": {
    "icon-size": 21,
    "spacing": 10
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": [
      "",
      ""
    ]
  },
  "battery": {
    "interval": 15,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-alt": "{icon} {capacity}% ({time})",
    "format-time": "{H} h {m} min",
    "format-charging": "{icon} {capacity}% ({time})",
    "format-plugged": "{icon} {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "{cycles} cycles | {health}% health",
    "on-click-right": "kitty --class waybar-tui btop"
  },
  "clock": {
    "interval": 1,
    "format": "{:%a %d %b, %H:%M:%S}",
    "format-alt": "{:%H:%M:%S}",
    "tooltip": false
  },
  "custom/padding": {
    "format": " ",
    "tooltip": false
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "network": {
    "interval": 3,
    "format": "{ifname}",
    "format-alt": "{bandwidthUpBits}  | {bandwidthDownBits} ",
    "format-wifi": "{essid} ",
    "format-ethernet": "{ipaddr}/{cidr}  ",
    // "format-disconnected": "no internet...",
    "format-disconnected": "...",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{ifname} via {gwaddr}\n{frequency}GHz, Signal strength: {signalStrength}%",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click-right": "kitty --class waybar-tui impala"
  },
  "custom/vpn": {
    "interval": 5,
    "format": "{icon}{text}",
    "format-icons": {
      "connected": "",
      // "disconnected": ""
      "disconnected": ""
    },
    "exec": "$HOME/.config/waybar/scripts/vpn.sh",
    "return-type": "json"
  },
  "custom/backup": {
    "interval": 30,
    "format": "",
    "exec": "$HOME/.config/waybar/scripts/backup.sh",
    "return-type": "json"
  },
  "custom/spotifyd": {
    "interval": 5,
    "format": "{icon}",
    "format-icons": {
      "test": "",
      "running": "",
      "default": ""
    },
    "on-click-right": "notify-send 'waybar - spotifyd' \"$(playerctl-focus spotifyd)\"",
    "exec": "$HOME/.config/waybar/scripts/spotifyd.sh",
    "return-type": "json"
  },
  "custom/opencode": {
    "interval": 60,
    "format": "{text}",
    "format-alt": "{alt}",
    "exec": "bun $XDG_CONFIG_HOME/waybar/scripts/opencode/main.ts",
    "return-type": "json"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon} ",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        ""
      ]
    },
    "scroll-step": 1
  },
  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias} ({controller_address})",
    "tooltip-format-connected": "{controller_alias} ({controller_address})\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} ({device_address})",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click-right": "kitty --class waybar-tui bluetui"
  },
  "cpu": {
    "interval": 10,
    "format": "{usage}% ",
    "max-length": 10
  },
  "memory": {
    "interval": 10,
    "states": {
      "warning": 60,
      "critical": 90
    },
    "format": "{used:0.1f}G ",
    "tooltip-format": "{swapUsed:0.1f}G/{swapTotal:0.1f}G Swap"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "timeout": 120
  }
}
