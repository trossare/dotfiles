{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "model": "opencode-go/gpt-6-luna",
  "agents": {
    "podman": {
      "description": "Uses podman to run scripts in a container rather than on host",
      "mode": "primary",
      "color": "#d0fad2",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "allow" },
      ],
    },
    "chat": {
      "description": "A lightweight conversational assistant.",
      "mode": "primary",
      "color": "#f3383e",
      "system": "You are a helpful conversational assistant. Answer clearly and concisely. Ask a clarifying question only when needed.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "opencode", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },

        // Online search
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },

        // temp-dir related
        { "action": "skill", "resource": "temp-dir", "effect": "allow" },
        { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },
        { "action": "read", "resource": "/tmp/opencode", "effect": "allow" },
        { "action": "read", "resource": "/tmp/opencode/*", "effect": "allow" },
        { "action": "edit", "resource": "/tmp/opencode/*", "effect": "allow" }
      ]
    }
  }
}

